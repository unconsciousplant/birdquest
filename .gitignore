# ---------------------------------------------------------------
# Files Git should never track for BirdQuest
# ---------------------------------------------------------------

# Installed packages (recreate with `npm install`)
node_modules/

# Build output (recreate with `npm run build`)
dist/
dist-ssr/

# Secrets and local environment files.
# Keep a .env.example with placeholder values only, never real keys.
.env
.env.*
!.env.example
*.local
*.pem
*.key
secrets/

# Private documents: personal information, student IDs, marking sheets, etc.
# Put them in a folder called private/ (anywhere in the project).
private/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage reports
coverage/

# Operating system files
.DS_Store
Thumbs.db

# Claude Code's personal local settings (the shared .claude/launch.json is kept)
.claude/settings.local.json

# Editor folders and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
